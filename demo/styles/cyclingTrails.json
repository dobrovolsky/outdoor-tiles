{
    "version": 8,
    "sources": {
        "trails": {
            "type": "vector",
            "url": "/tiles/trails",
            "attribution": "&copy; <a href=\"https://www.openstreetmap.org/copyright\" target=\"_blank\">OpenStreetMap contributors</a>"
        }
    },
    "layers": [
        {
            "id": "cyclingTrailsHighlight",
            "type": "line",
            "source": "trails",
            "source-layer": "trails",
            "minzoom": 6,
            "filter": [
                "all",
                ["==", ["get", "class"], "bicycle"],
                ["==", ["get", "relation_id"], -1]
            ],
            "layout": { "line-join": "round", "line-cap": "round" },
            "paint": {
                "line-color": "rgba(255, 255, 255, 0.95)",
                "line-blur": 1,
                "line-width": [
                    "interpolate",
                    ["exponential", 1.2],
                    ["zoom"],
                    6,
                    5,
                    12,
                    6,
                    13,
                    7,
                    15,
                    7.5
                ]
            }
        },
        {
            "id": "cyclingTrailsColored",
            "type": "line",
            "source": "trails",
            "source-layer": "trails",
            "minzoom": 6,
            "filter": ["==", ["get", "class"], "bicycle"],
            "layout": { "line-join": "round" },
            "paint": {
                "line-color": [
                    "match",
                    ["get", "color"],
                    "yellow",
                    "#ffd900",
                    "green",
                    "#4b9e2a",
                    "red",
                    "#ed341c",
                    "brown",
                    "#8b5a3c",
                    "black",
                    "#2e2e2e",
                    "purple",
                    "#a852cc",
                    "orange",
                    "#fa9200",
                    "#2874d8"
                ],
                "line-dasharray": [2.5, 1],
                "line-width": [
                    "interpolate",
                    ["exponential", 1.2],
                    ["zoom"],
                    6,
                    1,
                    12,
                    2,
                    13,
                    3,
                    15,
                    3.5
                ]
            }
        },
        {
            "id": "cyclingTrailsLabels",
            "type": "symbol",
            "source": "trails",
            "source-layer": "trail_labels",
            "minzoom": 11,
            "filter": [
                "all",
                ["==", ["get", "class"], "bicycle"],
                ["any", ["has", "symbol"], ["has", "ref"], ["has", "name"]]
            ],
            "layout": {
                "symbol-placement": "line",
                "symbol-spacing": 600,
                "icon-image": [
                    "case",
                    ["all", ["has", "symbol"], ["!=", ["get", "symbol"], "no"]],
                    ["concat", "trails:", ["get", "symbol"]],
                    ""
                ],
                "icon-padding": 2,
                "icon-rotation-alignment": "viewport",
                "text-field": [
                    "case",
                    ["all", ["has", "symbol"], ["!=", ["get", "symbol"], "no"]],
                    "",
                    ["coalesce", ["get", "ref"], ["get", "name"]]
                ],
                "text-font": ["Noto Sans Bold"],
                "text-size": ["interpolate", ["linear"], ["zoom"], 11, 9, 16, 13]
            },
            "paint": {
                "text-color": "#1e59a8",
                "text-halo-color": "rgba(255, 255, 255, 0.9)",
                "text-halo-width": 2
            }
        }
    ]
}
